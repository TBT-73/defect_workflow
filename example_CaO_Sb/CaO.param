# Production settings, used by every job of the workflow. The scripts set task, and per job
# charge, spin, spin_polarized and the k-points; A1 replaces cut_off_energy with the converged
# value. Leave charge and spin out (A1 drops them from production.param if they are here).
xc_functional   : PBE
cut_off_energy  : 600 eV
elec_energy_tol : 1e-6 eV
max_scf_cycles  : 200
finite_basis_corr   automatic
fix_occupancy       false         ! Treat the system as an metal
opt_strategy        default       
num_dump_cycles     0             ! Don't write unwanted ".wvfn" files.
spin_polarised      true          ! Run a spin polarised calculation
smearing_width      0.05 eV
geom_preconditioner EXP

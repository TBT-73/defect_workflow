# Defect workflow project CaO_screen: how its jobs run (CaO_screen.run), here on young-ng (Young's
# new environment). The science is in CaO_screen.parameters, beside it, and dwf.py reads both:
#   nohup python3 dwf.py CaO_screen > run.log 2>&1 &
# Written like a CASTEP .param/.cell file: "keyword : value", %block ... %endblock, keywords in
# any case, # or ! starts a comment. Lines starting with ! are optional settings with an example
# value: delete the ! to use one. File names are relative to this file.

!workdir  : dwf_CaO_Sb         # where everything goes (default dwf_<name>, beside these files)

# ======================================================================= CASTEP jobs
# How the CASTEP jobs run: any supercell_convergence.py runner keyword (see its --example).
# These are for Young's new environment, young-ng, whose standard nodes (40 cores, 188 GB
# usable) are never shared between jobs: every job fills whole nodes. Its Free jobs (all of
# them, until project allocations are enabled there) may run for up to 24 hours.
jobscript      : young_ng.sh   # template with {SEED}, {NODES}, {TASKS_PER_NODE}, {CPUS_PER_TASK}
cores_per_node : 40
charging       : node          # whole nodes (core: shared nodes, charged by the core)
max_nodes      : 2             # most nodes per job (more or fewer for some steps: below)
mem_per_core   : 4.5           # GB: the template's 180G per node; a job that needs more per
                               #   process gets fewer processes per node (no partitions: Slurm
                               #   picks the standard nodes from what a job asks for)
!max_walltime  : 12:00:00      # the longest a job may run (default: the template's --time)
dryrun_on        : compute     # the dry runs as jobs, up to dryrun_pack of a step's side by
dryrun_time      : 0:30:00     #   side in one job, one process each (on one node)
dryrun_pack      : 40
!dryrun_on       : login       # ... or where dwf.py runs, with CASTEP's module loaded there
!dryrun_cmd      : castep.mpi --dryrun {seed}
max_jobs  : 16                 # most jobs of one step queued at once
max_restarts : 20              # a relaxation that runs out of time carries on this many times
poll      : 30
delete_check : true            # delete each .check once its calculation has finished
# ... and for some steps only, in a runner block: runner_host for all of phase A's CASTEP
# steps (A1 to A3.1), runner_screen for those at the screening settings (C2, C3's single
# points, C5, C6, C7) and runner_production for those at the production settings (C8, D1, D2,
# F1, F2's single points); for one step: runner_converge (A1), runner_relax (A2.1),
# runner_bands (A2.2), runner_dielectric (A2.3), runner_phases (A3.1), runner_filter (C3),
# runner_drelax (C5), runner_rank (C6), runner_excite (C7), runner_validate (C8),
# runner_relaxations (D1), runner_zpl (D2), runner_ccd (F1), runner_lineshape (F2); the MACE
# jobs have blocks of their own (below). A step's own block wins over its group's, and that
# wins over the settings above, for the keywords they give (a %block partitions in one replaces
# the whole list).
# Starting points for CaO:Sb on young-ng - set your own. Young's documentation suggests jobs
# of 2 to 5 nodes; a Cirrus job of 288 cores would be about 7 of Young's nodes.
%block runner_host             # A1 to A3.1: the primitive cell and the competing phases
max_nodes    : 2
max_walltime : 2:00:00
%endblock runner_host
%block runner_converge         # A1: single points of the 2-atom primitive cell
max_nodes    : 1
pack         : 4               # four side by side on a node, 10 cores each
max_walltime : 0:20:00
%endblock runner_converge
# runner_screen covers every job at the screening settings, but only C2's and C3's single
# points are in the screening cell now: C5, C6 and C7 work in the electronic cell (432 atoms for
# CaO), so they get their own blocks below, which win over this one for the keywords they give.
# C2 here is about 14,000 single-node relaxations (4,709 candidates x 3 charge states), so they go
# as Slurm job arrays: max_jobs tasks queued at once (Slurm counts each task as a job), topped up
# with a new array as tasks finish. Check what Young lets you queue first, on a login node:
#   sacctmgr show assoc user=$USER format=user,account,maxsubmit,maxjobs
#   scontrol show config | grep -i maxarray
%block runner_screen           # C2, C3, C5, C6, C7: Gamma-only screening jobs
max_restarts : 1
max_nodes    : 1
max_walltime : 2:00:00
array        : 500             # jobs planned alike in Slurm job arrays of up to 500 tasks
max_jobs     : 500             # at most 500 tasks queued at once (UCL caps an array at 1,000)
!array_min   : 125             # send another array once this many places are free (default: a
                               #   quarter of array, 125 here): bigger means fewer, bigger
                               #   arrays, but a queue that runs lower while the runner waits.
                               #   C5, C6 and C7 would inherit it too (capped at their 16)
%endblock runner_screen
%block runner_drelax           # C5: relaxations in the electronic cell, phase C's biggest
max_nodes    : 4
max_restarts : 3               # a relaxation that runs out of its 24 hours carries on
max_walltime : 24:00:00
max_jobs     : 16              # runner_screen's 500 is for C2's thousands
%endblock runner_drelax
%block runner_rank             # C6: distortions tried in other charge states
max_nodes    : 4
max_restarts : 3
max_walltime : 24:00:00
max_jobs     : 16              # runner_screen's 500 is for C2's thousands
%endblock runner_rank
%block runner_excite           # C7: ground and excited states, in the electronic cell
max_nodes    : 4
max_restarts : 3
max_walltime : 24:00:00
max_jobs     : 16              # runner_screen's 500 is for C2's thousands
%endblock runner_excite
%block runner_production       # C8, D1, D2, F1, F2: the production settings, electronic cell
max_nodes    : 4
%endblock runner_production
# On Cirrus (288 cores a node, shared, charged by the core) these were: jobscript : cirrus.sh,
# cores_per_node : 288, charging : core, max_cores (in place of max_nodes) 288 by default, 64 for
# runner_host, 16 for runner_converge and 32 for runner_screen, runner_host's max_walltime
# 1:00:00, no restarts in C5, C6 or C7 beyond runner_screen's one, %block partitions with standard
# 2.6 --qos=standard and highmem 5.3 --qos=standard, and the dry runs with dryrun_partition :
# standard, dryrun_pack : 32 and dryrun_options : --qos=standard.
# On a machine that charges whole nodes, such as ARCHER2: jobscript : archer2.sh,
# cores_per_node : 128, charging : node (the default) with max_nodes (nodes per job) in place
# of max_cores, %block partitions with standard 2 --qos=standard and highmem 4 --qos=highmem,
# and dryrun_on : login with dryrun_cmd : castep.serial --dryrun {seed} (ARCHER2's serial
# partition rejects whole-node jobs); pack : N then runs N small jobs side by side on a node.

# ======================================================================= MACE jobs
mace_threads : 8               # threads per MACE relaxation
# The MACE relaxations run where dwf.py runs, unless mace_jobscript is given: then as jobs on
# compute nodes, each running up to mace_pack relaxations side by side (default
# cores_per_node / mace_threads, 5 here) on a whole node (young-ng doesn't share CPU nodes),
# in at most mace_max_jobs jobs at a time. (On Cirrus: cirrus_mace.sh, 36 to a job.)
mace_jobscript : young_ng_mace.sh  # a Slurm template with a {COMMAND} line
!mace_max_jobs : 4
!mace_python   : <your Scratch>/dwf_venv/bin/python   # the Python the jobs run (default: the
                               #   one running dwf.py; Young's compute nodes see home and
                               #   Scratch, so any of yours will do)
# B2 relaxes every candidate in every size it fits: here 4,709 candidates in up to seven sizes,
# tens of thousands of relaxations, shared out over at most mace_max_jobs jobs of mace_pack (5)
# side by side, so the 4 jobs above run 20 at a time. Give B2 more jobs (each is a node: check
# what Young lets you queue), and the time they need, in its own block (runner_prerelax does the
# same for C1). Such a block may give mace_jobscript, mace_pack, mace_max_jobs, mace_threads,
# mace_python, mace_device and max_walltime, each job's --time (default: the template's):
!%block runner_scan
!mace_max_jobs : 40
!max_walltime  : 24:00:00
!%endblock runner_scan

# ======================================================================= F2's model jobs
model_jobscript : young_ng_gpu.sh  # F2's trainings and phonons as jobs on one of
model_device    : cuda             #   young-ng's A100 GPUs (on Cirrus EX4000, which has no
                                   #   GPU nodes: cirrus_model.sh and model_device : cpu)

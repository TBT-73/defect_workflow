<mxCell id="n_a_given" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Use your &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;.param&lt;/span&gt; and&lt;br&gt;k-points as they are&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="359.04" y="398.77" width="188.35" height="75.72" as="geometry" /></mxCell>
<mxCell id="n_a_more" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Not settled: add finer&lt;br&gt;grids or higher cut-offs,&lt;br&gt;then rerun&lt;/div&gt;" style="shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=1;size=13.73;flipV=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=14.52;spacingRight=14.52;fillColor=#fff3c4;strokeColor=#b88a00;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="359.04" y="704.32" width="188.35" height="93.56" as="geometry" /></mxCell>
<mxCell id="n_a_epsuse" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Use that value&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="359.04" y="1162.58" width="188.35" height="57.87" as="geometry" /></mxCell>
<mxCell id="n_a_muuse" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Use them (&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;%block&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;chemical_potentials&lt;/span&gt;)&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="359.04" y="1454.99" width="188.35" height="75.72" as="geometry" /></mxCell>
<mxCell id="n_a_nomu" value="&lt;div style=&quot;line-height:1.28&quot;&gt;No limits: formation&lt;br&gt;energies without μ terms&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="359.04" y="1624.79" width="188.35" height="75.72" as="geometry" /></mxCell>
<mxCell id="n_a_stop" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Stop: check those&lt;br&gt;phases and their&lt;br&gt;settings&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;spacing=0;spacingLeft=28.07;spacingRight=28.07;fillColor=#fbe3e3;strokeColor=#c03a3a;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="359.04" y="1921.91" width="188.35" height="93.56" as="geometry" /></mxCell>
<mxCell id="n_a_in" value="&lt;div style=&quot;line-height:1.28&quot;&gt;project file &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;&amp;lt;name&amp;gt;.dwf&lt;/span&gt;,&lt;br&gt;host &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;.cell&lt;/span&gt; and &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;.param&lt;/span&gt;, jobscript&lt;/div&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=15.7;whiteSpace=wrap;html=1;spacing=0;spacingLeft=17.27;spacingRight=17.27;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="68.67" y="243.28" width="274.67" height="94.17" as="geometry" /></mxCell>
<mxCell id="n_a_conv" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Converge k-points and&lt;br&gt;cut-off? (&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;converge&lt;/span&gt;)&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="92.21" y="380.13" width="227.59" height="113.01" as="geometry" /></mxCell>
<mxCell id="n_a1" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;A1  Converge k-points and cut-off&lt;/span&gt;&lt;br&gt;host energy per atom on each k-point&lt;br&gt;grid (at a low cut-off), then for each&lt;br&gt;cut-off in &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;converge_cutoffs&lt;/span&gt;&lt;/div&gt;" style="shape=process;size=0.0324;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="60.82" y="535.81" width="290.37" height="111.41" as="geometry" /></mxCell>
<mxCell id="n_a1ok" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Has the energy settled,&lt;br&gt;within &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;converge_tol&lt;/span&gt;?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="92.21" y="689.89" width="227.59" height="122.43" as="geometry" /></mxCell>
<mxCell id="n_a21" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;A2.1  Relax the host&lt;/span&gt;&lt;br&gt;lattice and positions, at A1's settings;&lt;br&gt;every later cell is built from it&lt;/div&gt;" style="shape=process;size=0.0324;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="60.82" y="857.83" width="290.37" height="93.56" as="geometry" /></mxCell>
<mxCell id="n_a22" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;A2.2  Band edges&lt;/span&gt;&lt;br&gt;a single point on a dense Γ-centred grid:&lt;br&gt;VBM, CBM and band gap&lt;/div&gt;" style="shape=process;size=0.0324;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="60.82" y="994.07" width="290.37" height="93.56" as="geometry" /></mxCell>
<mxCell id="n_a_eps" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Dielectric constant&lt;br&gt;given? (&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;dielectric&lt;/span&gt;)&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="96.14" y="1130.3" width="219.74" height="122.43" as="geometry" /></mxCell>
<mxCell id="n_a23" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;A2.3  Dielectric constant&lt;/span&gt;&lt;br&gt;DFPT at Γ (&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;phonon+efield&lt;/span&gt;): ε₀ and ε∞;&lt;br&gt;ε₀ screens every charge correction&lt;/div&gt;" style="shape=process;size=0.0324;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="60.82" y="1295.4" width="290.37" height="93.56" as="geometry" /></mxCell>
<mxCell id="n_a_mu" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Chemical potentials&lt;br&gt;given?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="96.14" y="1431.63" width="219.74" height="122.43" as="geometry" /></mxCell>
<mxCell id="n_a_ph" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Competing phases given?&lt;br&gt;(&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;phases&lt;/span&gt;, or &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;phases_from&lt;/span&gt;)&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="88.29" y="1596.73" width="235.43" height="131.84" as="geometry" /></mxCell>
<mxCell id="n_a31" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;A3.1  Relax the competing phases&lt;/span&gt;&lt;br&gt;yours, or the Materials Project's (doped),&lt;br&gt;at the same settings as the host&lt;/div&gt;" style="shape=process;size=0.0324;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="60.82" y="1771.24" width="290.37" height="93.56" as="geometry" /></mxCell>
<mxCell id="n_a_st" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Is the host stable&lt;br&gt;against them?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="96.14" y="1907.48" width="219.74" height="122.43" as="geometry" /></mxCell>
<mxCell id="n_a32" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;A3.2  Chemical-potential limits&lt;/span&gt;&lt;br&gt;μ at each corner of the host's stability&lt;br&gt;region (pymatgen); each dopant's μ is&lt;br&gt;the highest its own phases allow&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="60.82" y="2072.58" width="290.37" height="111.41" as="geometry" /></mxCell>
<mxCell id="n_a_out" value="B" style="ellipse;aspect=fixed;fontStyle=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=16.48;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="182.46" y="2223.81" width="47.09" height="47.09" as="geometry" /></mxCell>
<mxCell id="n_b_user" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;B1  Your defects&lt;/span&gt;&lt;br&gt;one candidate per line;&lt;br&gt;a pair with &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;all&lt;/span&gt;: every&lt;br&gt;arrangement of it&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="898.57" y="338.55" width="188.35" height="111.41" as="geometry" /></mxCell>
<mxCell id="n_b_noscan" value="&lt;div style=&quot;line-height:1.28&quot;&gt;No test: B3 goes by&lt;br&gt;the Γ-only floor alone&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="898.57" y="903.99" width="188.35" height="75.72" as="geometry" /></mxCell>
<mxCell id="n_b_fixed" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Use it (B2's test is&lt;br&gt;then only reported)&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="898.57" y="1270.73" width="188.35" height="93.56" as="geometry" /></mxCell>
<mxCell id="n_b_warn" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Warning: Γ-point&lt;br&gt;screening sees a wider&lt;br&gt;gap (C2 measures it);&lt;br&gt;B4's electronic cell&lt;br&gt;folds the edges&lt;/div&gt;" style="shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=1;size=13.73;flipV=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=14.52;spacingRight=14.52;fillColor=#fff3c4;strokeColor=#b88a00;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="898.57" y="1592.86" width="188.35" height="129.25" as="geometry" /></mxCell>
<mxCell id="n_b_in" value="A" style="ellipse;aspect=fixed;fontStyle=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=16.48;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="722.0" y="243.28" width="47.09" height="47.09" as="geometry" /></mxCell>
<mxCell id="n_b_known" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Defects listed in&lt;br&gt;&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;%block defects&lt;/span&gt;?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="635.67" y="333.04" width="219.74" height="122.43" as="geometry" /></mxCell>
<mxCell id="n_b1" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;B1  List the candidates&lt;/span&gt;&lt;br&gt;vacancies and dopant substitutions on&lt;br&gt;each inequivalent site (antisites and&lt;br&gt;interstitials too, if switched on), then&lt;br&gt;dopant–native pairs in every distinct&lt;br&gt;arrangement up to &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;pair_max_distance&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="600.36" y="498.14" width="290.37" height="147.1" as="geometry" /></mxCell>
<mxCell id="n_b2a" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;B2  Supercell sizes&lt;/span&gt;&lt;br&gt;for each length in &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;scan_lengths&lt;/span&gt;, the&lt;br&gt;most compact supercell whose periodic&lt;br&gt;images are at least that far apart&lt;br&gt;(found by doped, or n × your &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;transform&lt;/span&gt;)&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="600.36" y="699.29" width="290.37" height="129.25" as="geometry" /></mxCell>
<mxCell id="n_b_mace" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Test each candidate's&lt;br&gt;size with MACE?&lt;br&gt;(&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;mace&lt;/span&gt; and &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;scan&lt;/span&gt;)&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="635.67" y="871.22" width="219.74" height="141.26" as="geometry" /></mxCell>
<mxCell id="n_b2" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;B2  MACE size test&lt;/span&gt;&lt;br&gt;each candidate relaxed in every size it&lt;br&gt;fits; it needs the smallest size whose&lt;br&gt;relaxation energy matches every bigger&lt;br&gt;size's within &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;scan_tol&lt;/span&gt;, with its edge&lt;br&gt;atoms moving less than &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;scan_edge_tol&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#e2f3e6;strokeColor=#1f8a3c;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="600.36" y="1055.15" width="290.37" height="147.1" as="geometry" /></mxCell>
<mxCell id="n_b_sc" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Screening cell given?&lt;br&gt;(&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;supercell&lt;/span&gt;)&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="635.67" y="1256.3" width="219.74" height="122.43" as="geometry" /></mxCell>
<mxCell id="n_b3" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;B3  Choose the screening cell&lt;/span&gt;&lt;br&gt;the smallest size that is big enough for&lt;br&gt;every candidate (the worst case decides)&lt;br&gt;and at least the Γ-only floor (note below)&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="600.36" y="1421.4" width="290.37" height="111.41" as="geometry" /></mxCell>
<mxCell id="n_b_fold" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Do the host's band&lt;br&gt;edges (A2.2) fold onto&lt;br&gt;Γ of this cell?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="627.82" y="1586.86" width="235.43" height="141.26" as="geometry" /></mxCell>
<mxCell id="n_b_out" value="C" style="ellipse;aspect=fixed;fontStyle=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=16.48;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="722.0" y="1908.40" width="47.09" height="47.09" as="geometry" /></mxCell>
<mxCell id="n_c_cfgdrop" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Drop arrangements more&lt;br&gt;than that above the&lt;br&gt;lowest MACE energy of&lt;br&gt;their composition&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#e2f3e6;strokeColor=#1f8a3c;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1438.11" y="464.78" width="188.35" height="111.41" as="geometry" /></mxCell>
<mxCell id="n_c_drop" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Dropped (the reason&lt;br&gt;is in &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;summary.txt&lt;/span&gt;)&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;spacing=0;spacingLeft=22.71;spacingRight=22.71;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1438.11" y="840.84" width="188.35" height="75.72" as="geometry" /></mxCell>
<mxCell id="n_c_in" value="B" style="ellipse;aspect=fixed;fontStyle=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=16.48;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1261.53" y="243.28" width="47.09" height="47.09" as="geometry" /></mxCell>
<mxCell id="n_c1" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;C1  Build and pre-relax&lt;/span&gt;&lt;br&gt;every candidate in the screening cell,&lt;br&gt;pre-relaxed with MACE (reusing B2's)&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#e2f3e6;strokeColor=#1f8a3c;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1139.89" y="324.51" width="290.37" height="93.56" as="geometry" /></mxCell>
<mxCell id="n_c_cfg" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Filter by MACE energy?&lt;br&gt;(&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;configuration_margin&lt;/span&gt;)&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1171.28" y="452.21" width="227.59" height="136.55" as="geometry" /></mxCell>
<mxCell id="n_c2" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;C2  Screen in CASTEP&lt;/span&gt;&lt;br&gt;a cheap Γ-point relaxation of every&lt;br&gt;candidate in each of &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;screen_charges&lt;/span&gt;,&lt;br&gt;from a triplet (a doublet for an odd&lt;br&gt;electron count), plus the pristine cell&lt;/div&gt;" style="shape=process;size=0.0324;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1139.89" y="634.27" width="290.37" height="129.25" as="geometry" /></mxCell>
<mxCell id="n_c3" value="&lt;div style=&quot;line-height:1.28&quot;&gt;C3: passes the hull&lt;br&gt;(charge-corrected), duplicate&lt;br&gt;and property filters?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1167.36" y="803.36" width="235.43" height="150.68" as="geometry" /></mxCell>
<mxCell id="n_c4" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;C4  Distort (ShakeNBreak)&lt;/span&gt;&lt;br&gt;in the electronic cell, each charge state&lt;br&gt;C3 carries on: neighbours moved in and&lt;br&gt;out by each of &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;distortions&lt;/span&gt;, others rattled&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#fde9dc;strokeColor=#d0612a;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1139.89" y="1127.26" width="290.37" height="111.41" as="geometry" /></mxCell>
<mxCell id="n_c5" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;C5  Relax the distortions&lt;/span&gt;&lt;br&gt;and each start, at Γ with C2's settings,&lt;br&gt;against the electronic cell's band edges;&lt;br&gt;every step kept: D1's training data&lt;/div&gt;" style="shape=process;size=0.0324;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1139.89" y="1260.67" width="290.37" height="111.41" as="geometry" /></mxCell>
<mxCell id="n_c_mid" value="D" style="ellipse;aspect=fixed;fontStyle=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=16.48;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1261.53" y="1406.28" width="47.09" height="47.09" as="geometry" /></mxCell>
<mxCell id="n_e_fermi" value="&lt;div style=&quot;line-height:1.28&quot;&gt;The self-consistent Fermi&lt;br&gt;level of each dopant set&lt;br&gt;(native, each dopant, each&lt;br&gt;mix); &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;quench_temperature&lt;/span&gt;:&lt;br&gt;also after a quench&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="3056.72" y="646.71" width="188.35" height="147.1" as="geometry" /></mxCell>
<mxCell id="n_e_end" value="&lt;div style=&quot;line-height:1.28&quot;&gt;End: formation energies,&lt;br&gt;levels and Fermi levels&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;spacing=0;spacingLeft=22.71;spacingRight=22.71;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="3056.72" y="886.25" width="188.35" height="75.72" as="geometry" /></mxCell>
<mxCell id="n_e_in" value="E" style="ellipse;aspect=fixed;fontStyle=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=16.48;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2880.14" y="243.28" width="47.09" height="47.09" as="geometry" /></mxCell>
<mxCell id="n_e1" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;F1  Charge corrections&lt;/span&gt;&lt;br&gt;Lany–Zunger or Makov–Payne&lt;br&gt;(&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;charge_correction&lt;/span&gt;), in the&lt;br&gt;electronic cell&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2758.5" y="333.04" width="290.37" height="129.25" as="geometry" /></mxCell>
<mxCell id="n_e2" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;F2  Formation energies&lt;/span&gt;&lt;br&gt;at each chemical-potential limit, and&lt;br&gt;the transition levels; plotted in&lt;br&gt;&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;formation.png&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2758.5" y="504.97" width="290.37" height="111.41" as="geometry" /></mxCell>
<mxCell id="n_e_f" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Find the Fermi level?&lt;br&gt;(&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;fermi_temperature&lt;/span&gt;)&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2793.82" y="659.05" width="219.74" height="122.43" as="geometry" /></mxCell>
<mxCell id="n_e3" value="&lt;div style=&quot;line-height:1.28&quot;&gt;F3: an E2 excitation&lt;br&gt;whose charge state&lt;br&gt;forms in the gap?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2785.97" y="844.06" width="235.43" height="160.1" as="geometry" /></mxCell>
<mxCell id="n_e_out" value="G" style="ellipse;aspect=fixed;fontStyle=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=16.48;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2880.14" y="1046.83" width="47.09" height="47.09" as="geometry" /></mxCell>
<mxCell id="m1" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;The Γ-only floor (B3, B4)&lt;/div&gt;&lt;div&gt;Γ-point runs see a defect's levels as an isolated defect has them only when its periodic images barely overlap. A level E&lt;sub&gt;b&lt;/sub&gt; inside the gap decays as &lt;span style=&quot;white-space:nowrap&quot;&gt;exp(−r/ξ)&lt;/span&gt;, where (two-band model) 1/ξ² = (2m*/ħ²) E&lt;sub&gt;b&lt;/sub&gt; (1 − E&lt;sub&gt;b&lt;/sub&gt;/E&lt;sub&gt;g&lt;/sub&gt;). A cell's images are at least &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;decay_length_multiple&lt;/span&gt; × ξ apart (4ξ by default), with&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  E&lt;sub&gt;b&lt;/sub&gt; = &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;deep_level_margin&lt;/span&gt; (B3) or &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;electronic_depth&lt;/span&gt; (B4)&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  m*: the lighter of the hole and electron masses at A2.2's band edges&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  E&lt;sub&gt;g&lt;/sub&gt;: A2.2's band gap&lt;/div&gt;&lt;div&gt;Set &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;screen_min_image&lt;/span&gt; to give B3's floor yourself (0: no floor).&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes" connectable="0"><mxGeometry x="590.55" y="1969.49" width="500.3" height="193.82" as="geometry" /></mxCell>
<mxCell id="m2" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;Cell sizes are image distances&lt;/div&gt;&lt;div&gt;The shortest distance between a defect and its periodic images (Å), from &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;scan_lengths&lt;/span&gt;: B2 tests every candidate in every size, B3's screening cell fits the worst case and the Γ-only floor, and B4's electronic cell (C4 on) also folds the band edges onto Γ.&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes" connectable="0"><mxGeometry x="590.55" y="2171.31" width="500.3" height="110.00" as="geometry" /></mxCell>
<mxCell id="m3" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;What C keeps for D1–D5&lt;/div&gt;&lt;div&gt;Every geometry step of C5, with its energy and forces, in each &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;.castep&lt;/span&gt;: D1 turns them into each defect's training data (the &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;pbe&lt;/span&gt; head, at the screening settings), and D2 recomputes a tenth of them with the hybrid, in the electronic cell like everything after C3. With &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;model : false&lt;/span&gt;, D6 ranks C5's relaxations instead.&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes" connectable="0"><mxGeometry x="1130.08" y="1471.37" width="500.3" height="130.00" as="geometry" /></mxCell>
<mxCell id="m4" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;The model in D1–D5: Wang et al.&lt;/div&gt;&lt;div&gt;Wang, Mosquera-Lois and Walsh, PRX Energy 2026 (arXiv:2603.05238): Sb₂Se₃, one 60-atom cell, VASP (PAW, 350 eV, DFT-D3).&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  V&lt;sub&gt;Se&lt;/sub&gt;(1) in q = −2 … +2: one charge-embedded MACE, trained on HSE06 Γ-point relaxations of ShakeNBreak distortions (2,287 structures)&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  neutral V&lt;sub&gt;Se&lt;/sub&gt;(1): a multi-fidelity MACE from 452 PBE steps and 34 HSE06 single points&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  MACE 0.3.15 from scratch: 2 layers, 128 channels, 5.5 Å cut-off, ZBL&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  test errors 0.5 meV/atom and 20 meV/Å; transition levels within 0.015 eV of HSE06; the search about 1,000 × cheaper than HSE06&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  one model per defect, site and cell size; negative charge states were the hardest; the charge embedding and the two heads (D3) were never tested together: they trained them as two models&lt;/div&gt;&lt;div&gt;Data and trained models: Zenodo, record 22756145 (CC BY 4.0).&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes" connectable="0"><mxGeometry x="1130.08" y="1611.37" width="500.3" height="277.95" as="geometry" /></mxCell>
<mxCell id="m5" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;Foundation models on defects (their test)&lt;/div&gt;&lt;div&gt;On V&lt;sub&gt;Sb&lt;/sub&gt;(1) at the PBE level, MACE-MH-1, MACE-MPA-0, GRACE-2L-OMAT and MatterSim put the minima 0.2–0.4 Å from DFT's (0.1 Å counts as a match), on flatter energy surfaces, and DFT relaxations from their minima missed the DFT ground states. The charge-aware MACE-POLAR-1-L and QET-PES-MatQ failed too. So B2 and C1 keep a foundation MACE for cell sizes and pre-relaxation only, and each defect gets a model trained on its own DFT data (D3).&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes" connectable="0"><mxGeometry x="1130.08" y="1899.32" width="500.3" height="167.96" as="geometry" /></mxCell>
<mxCell id="m6" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;What the filters in C and D keep&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  C1 &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;configuration_margin&lt;/span&gt;: arrangements within that of the lowest MACE energy of their composition (MACE ignores the charge)&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  C3 hull: an arrangement stays if, at some Fermi level in the gap, its lowest formation energy is within &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;hull_margin&lt;/span&gt; of its group's&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  C3 duplicates: one that relaxed into a lower one's structure goes&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  C3 properties (optional), met by a charge state stable somewhere in the gap: &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;require_gap_states&lt;/span&gt;, &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;require_spin&lt;/span&gt;, &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;require_bound&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  D6: the &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;keep_structures&lt;/span&gt; lowest structures of each charge state&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes" connectable="0"><mxGeometry x="1130.08" y="2077.28" width="500.3" height="182.99" as="geometry" /></mxCell>
<mxCell id="m7" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;D7: which excitations go on&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  levels: bands localised on the defect (participation number at most &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;local_fraction&lt;/span&gt; of the atoms), in the gap or up to &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;excite_reach&lt;/span&gt; inside a band, where PBE's narrow gap pushes many&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  the excitation: in each spin channel, the highest occupied level to the lowest empty one; CASTEP's ΔSCF from the ground state's &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;.check&lt;/span&gt;, relaxed&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  1D estimates: E&lt;sub&gt;rel&lt;/sub&gt; = E&lt;sub&gt;abs&lt;/sub&gt; − ZPL, ħω = ħ√(2E&lt;sub&gt;rel&lt;/sub&gt;)/ΔQ, S = E&lt;sub&gt;rel&lt;/sub&gt;/ħω, DW = e&lt;sup&gt;−S&lt;/sup&gt; (a lower bound)&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  a defect that passes goes on with all its charge states; native defects always do&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes" connectable="0"><mxGeometry x="1669.62" y="1843.49" width="500.3" height="214.00" as="geometry" /></mxCell>
<mxCell id="m8" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;Test D7 on one defect first&lt;/div&gt;&lt;div&gt;CASTEP's ΔSCF must work on your build: in CaO, Sb&lt;sub&gt;Ca&lt;/sub&gt;–V&lt;sub&gt;O&lt;/sub&gt; at q = −1 has a ZPL of about 0.53 eV (ADAQ). The thresholds are loose on purpose: the energies are PBE's.&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes" connectable="0"><mxGeometry x="1669.62" y="2067.49" width="500.3" height="104.70" as="geometry" /></mxCell>
<mxCell id="m9" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;How the CASTEP jobs run&lt;/div&gt;&lt;div&gt;Every CASTEP step hands its jobs to &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;supercell_convergence.py&lt;/span&gt;:&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  one short dry run per distinct input sizes the jobs: cores or nodes, memory, partition and walltime; where nodes are shared and charged by the core (Cirrus), each job asks for just the cores it needs&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  no more than &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;max_jobs&lt;/span&gt; are queued at once&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  a job that runs out of time carries on from its &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;.check&lt;/span&gt; (up to &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;max_restarts&lt;/span&gt; times; screening jobs don't restart)&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  with &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;tolerate_failures&lt;/span&gt; (the screening, hybrid and production steps), a failed job is flagged and the others carry on&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  a finished job whose inputs have since changed stops the run, so results from two different settings never mix&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;touch &amp;lt;workdir&amp;gt;/STOP&lt;/span&gt; stops dwf.py; queued jobs keep running&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes" connectable="0"><mxGeometry x="2209.16" y="1290.30" width="500.3" height="253.99" as="geometry" /></mxCell>
<mxCell id="m10" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;Stopping and rerunning&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;&amp;lt;workdir&amp;gt;/state.json&lt;/span&gt; records each finished step, with a fingerprint of its settings, input files and earlier results.&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  stopped (STOP, Ctrl-C, &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;--no-wait&lt;/span&gt;, a crash)? Run the same command again: finished steps are skipped, and jobs already submitted or finished are picked up&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  changed a setting? The steps that depend on it run again; jobs whose inputs are unchanged are reused&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;--redo STEP&lt;/span&gt;: start that step again (its old files are kept)&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;--status&lt;/span&gt;: what has finished; &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;--until B&lt;/span&gt;: stop after phase B&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;--prepare-only&lt;/span&gt;: write the job inputs, but submit nothing&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes" connectable="0"><mxGeometry x="2209.16" y="1556.05" width="500.3" height="218.96" as="geometry" /></mxCell>
<mxCell id="m11" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;Charge corrections: where they're applied&lt;/div&gt;&lt;div&gt;Lany–Zunger (default) or Makov–Payne: a point charge q screened by ε₀ (A2.3), in each cell's own shape (&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;charge_correction&lt;/span&gt;).&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  C3: the hull, stable charge states and binding (screening cell)&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  D8: each size's E&lt;sub&gt;D&lt;/sub&gt; − E&lt;sub&gt;host&lt;/sub&gt; + E&lt;sub&gt;corr&lt;/sub&gt;&lt;/div&gt;&lt;div style=&quot;padding-left:11.77px;text-indent:-9.42px&quot;&gt;&lt;span style=&quot;color:#55544f&quot;&gt;•&lt;/span&gt;  F1–F2: the electronic cell&lt;/div&gt;&lt;div&gt;Not included: potential alignment, an anisotropic ε (averaged).&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes" connectable="0"><mxGeometry x="2209.16" y="1786.78" width="500.3" height="150.03" as="geometry" /></mxCell>
<mxCell id="m12" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;Phase G, and after it&lt;/div&gt;&lt;div&gt;PBE lineshapes in the equal-mode approximation (Alkauskas et al. 2014; Razinkovas et al. 2021). The finalists then go on to better methods, outside this workflow.&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes" connectable="0"><mxGeometry x="2748.69" y="2112.80" width="500.3" height="96.00" as="geometry" /></mxCell>
<mxCell id="v2_n_b4" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;B4  The electronic cell (C4 on)&lt;/span&gt;&lt;br&gt;the smallest size, from the screening&lt;br&gt;cell up, that folds every band-edge&lt;br&gt;valley onto Γ (or &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;electronic_cell&lt;/span&gt;)&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="600.40" y="1775.00" width="290.40" height="111.40" as="geometry" /></mxCell><mxCell id="v2_e_b4" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_n_b4" target="n_b_out"><mxGeometry x="-1" relative="1" as="geometry" /></mxCell><mxCell id="v2_c_move" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;Into the electronic cell (B4)&lt;/span&gt;&lt;br&gt;everything after C3 works in it: each&lt;br&gt;survivor's screened structures carried&lt;br&gt;over (&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;distort_cell&lt;/span&gt;) and relaxed in C5&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1139.89" y="993.86" width="290.37" height="111.40" as="geometry" /></mxCell><mxCell id="v2_ec1" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_c_move" target="n_c4"><mxGeometry x="-1" relative="1" as="geometry" /></mxCell><mxCell id="v2_d_in" value="C" style="ellipse;aspect=fixed;fontStyle=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=16.48;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1801.07" y="243.30" width="47.09" height="47.09" as="geometry" /></mxCell><mxCell id="v2_d_model" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Search with a model&lt;br&gt;of each defect?&lt;br&gt;(&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;model&lt;/span&gt;)&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1706.91" y="318.00" width="235.40" height="150.00" as="geometry" /></mxCell><mxCell id="v2_d1" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;D1  Training data&lt;/span&gt;&lt;br&gt;each defect's C5 geometry steps and&lt;br&gt;rattled pristine cells, in the electronic&lt;br&gt;cell; filtered, a fifth kept for testing&lt;/div&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=15.7;whiteSpace=wrap;html=1;spacing=0;spacingLeft=17.27;spacingRight=17.27;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1679.40" y="498.00" width="290.40" height="111.40" as="geometry" /></mxCell><mxCell id="v2_d2" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;D2  Hybrid single points&lt;/span&gt;&lt;br&gt;HSE06 (norm-conserving) on about a&lt;br&gt;tenth of them, in the electronic cell:&lt;br&gt;first, last and an even sample&lt;/div&gt;" style="shape=process;size=0.0324;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1679.40" y="637.40" width="290.40" height="111.40" as="geometry" /></mxCell><mxCell id="v2_d3" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;D3  Train a model per defect&lt;/span&gt;&lt;br&gt;MACE from scratch: &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;pbe&lt;/span&gt; and &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;hse&lt;/span&gt; heads&lt;br&gt;on one representation, the total&lt;br&gt;charge embedded (every charge state)&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#e2f3e6;strokeColor=#1f8a3c;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1679.40" y="776.80" width="290.40" height="111.40" as="geometry" /></mxCell><mxCell id="v2_d4" value="&lt;div style=&quot;line-height:1.28&quot;&gt;D4: accurate? (test&lt;br&gt;errors; the hybrid's&lt;br&gt;forces at its&lt;br&gt;minima)&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1706.91" y="916.20" width="235.40" height="178.90" as="geometry" /></mxCell><mxCell id="v2_d_retrain" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Its minima's single&lt;br&gt;points join the data;&lt;br&gt;train again (at most&lt;br&gt;&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;model_rounds&lt;/span&gt;)&lt;/div&gt;" style="shape=process;size=0.0500;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1977.70" y="949.95" width="188.30" height="111.40" as="geometry" /></mxCell><mxCell id="v2_d5" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;D5  Search, electronic cell&lt;/span&gt;&lt;br&gt;ShakeNBreak distortions (±0.7) and&lt;br&gt;rattles in every charge state, relaxed&lt;br&gt;with the &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;hse&lt;/span&gt; head; each minimum tried&lt;br&gt;in the other charge states&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#e2f3e6;strokeColor=#1f8a3c;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1679.40" y="1123.10" width="290.40" height="129.20" as="geometry" /></mxCell><mxCell id="v2_d_j1" value="" style="ellipse;fillColor=#2b2b28;strokeColor=none;" vertex="1" parent="flow"><mxGeometry x="1821.66" y="1266.35" width="5.90" height="5.90" as="geometry" /></mxCell><mxCell id="v2_d6" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;D6  Rank the ground states&lt;/span&gt;&lt;br&gt;the model's lowest minima, or (no&lt;br&gt;model) C5's, sharing distortions;&lt;br&gt;&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;keep_structures&lt;/span&gt; go on&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1679.40" y="1284.30" width="290.40" height="111.40" as="geometry" /></mxCell><mxCell id="v2_d8" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;D8  Validate&lt;/span&gt;&lt;br&gt;the screening cell vs&lt;br&gt;bigger cells; Γ vs&lt;br&gt;k-points (for you)&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#55544f;dashed=1;dashPattern=3.8 2.6;" vertex="1" parent="flow"><mxGeometry x="1977.70" y="1284.30" width="188.30" height="111.40" as="geometry" /></mxCell><mxCell id="v2_d7" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;D7  Excited states (ΔSCF)&lt;/span&gt;&lt;br&gt;electronic cell, Γ: ground states&lt;br&gt;relaxed; triplets only; localised&lt;br&gt;levels (participation numbers);&lt;br&gt;ZPL, E&lt;sub&gt;abs&lt;/sub&gt;, ΔQ, 1D S and DW&lt;/div&gt;" style="shape=process;size=0.0324;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="1679.40" y="1423.70" width="290.40" height="129.20" as="geometry" /></mxCell><mxCell id="v2_d_pending" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Band states: pending,&lt;br&gt;for a hybrid later&lt;br&gt;(F3 lists them)&lt;/div&gt;" style="shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=1;size=13.73;flipV=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=14.52;spacingRight=14.52;fillColor=#fff3c4;strokeColor=#b88a00;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontCol
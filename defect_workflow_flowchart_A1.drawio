line=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2219.00" y="320.00" width="290.40" height="111.40" as="geometry" /></mxCell><mxCell id="v2_e_fail" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Did a job fail?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2254.30" y="459.40" width="219.70" height="103.60" as="geometry" /></mxCell><mxCell id="v2_e_flag" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Flagged, left out of F:&lt;br&gt;fix it and rerun with&lt;br&gt;&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;--resubmit-failed&lt;/span&gt;&lt;/div&gt;" style="shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=1;size=13.73;flipV=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=14.52;spacingRight=14.52;fillColor=#fff3c4;strokeColor=#b88a00;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2517.20" y="464.40" width="188.30" height="93.60" as="geometry" /></mxCell><mxCell id="v2_e_j1" value="" style="ellipse;fillColor=#2b2b28;strokeColor=none;" vertex="1" parent="flow"><mxGeometry x="2361.20" y="584.05" width="5.90" height="5.90" as="geometry" /></mxCell><mxCell id="v2_e2a" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;E2  The ground states again&lt;/span&gt;&lt;br&gt;production settings, the bands' weights:&lt;br&gt;the same excitation, found again&lt;/div&gt;" style="shape=process;size=0.0324;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2219.00" y="603.00" width="290.40" height="93.60" as="geometry" /></mxCell><mxCell id="v2_e_bands" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Its bands keep their&lt;br&gt;numbers at every&lt;br&gt;k-point? (spread &lt;&lt;br&gt;&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;band_spread_tol&lt;/span&gt;)&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2229.15" y="724.60" width="270.00" height="188.30" as="geometry" /></mxCell><mxCell id="v2_e_gamma" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Use a Γ-only ground&lt;br&gt;state instead, at the&lt;br&gt;production cut-off&lt;/div&gt;" style="shape=process;size=0.0500;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2525.00" y="771.95" width="188.30" height="93.60" as="geometry" /></mxCell><mxCell id="v2_e_j2" value="" style="ellipse;fillColor=#2b2b28;strokeColor=none;" vertex="1" parent="flow"><mxGeometry x="2361.20" y="933.95" width="5.90" height="5.90" as="geometry" /></mxCell><mxCell id="v2_e2b" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;E2  Production ΔSCF&lt;/span&gt;&lt;br&gt;relaxed: ZPL, E&lt;sub&gt;abs&lt;/sub&gt;, ΔQ, 1D S and DW,&lt;br&gt;with D7's verdicts; the excited&lt;br&gt;structures go on to G&lt;/div&gt;" style="shape=process;size=0.0324;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2219.00" y="952.90" width="290.40" height="111.40" as="geometry" /></mxCell><mxCell id="v2_e_out" value="F" style="ellipse;aspect=fixed;fontStyle=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=16.48;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2340.60" y="1090.30" width="47.09" height="47.09" as="geometry" /></mxCell><mxCell id="v2_ee1" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_e_in" target="v2_e1"><mxGeometry x="-1" relative="1" as="geometry" /></mxCell><mxCell id="v2_ee2" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_e1" target="v2_e_fail"><mxGeometry x="-1" relative="1" as="geometry" /></mxCell><mxCell id="v2_ee3" value="no" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_e_fail" target="v2_e2a"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="12.74" y="9.85" as="offset" /></mxGeometry></mxCell><mxCell id="v2_ee4" value="yes" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_e_fail" target="v2_e_flag"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="14.80" y="-10.16" as="offset" /></mxGeometry></mxCell><mxCell id="v2_ee5" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_e_flag" target="v2_e2a"><mxGeometry x="-1" relative="1" as="geometry"><Array as="points"><mxPoint x="2611.35" y="587.00" /><mxPoint x="2364.15" y="587.00" /></Array></mxGeometry></mxCell><mxCell id="v2_ee6" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_e2a" target="v2_e_bands"><mxGeometry x="-1" relative="1" as="geometry" /></mxCell><mxCell id="v2_ee7" value="yes" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_e_bands" target="v2_e2b"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="16.37" y="9.85" as="offset" /></mxGeometry></mxCell><mxCell id="v2_ee8" value="no" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_e_bands" target="v2_e_gamma"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="11.18" y="-10.16" as="offset" /></mxGeometry></mxCell><mxCell id="v2_ee9" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_e_gamma" target="v2_e2b"><mxGeometry x="-1" relative="1" as="geometry"><Array as="points"><mxPoint x="2619.15" y="936.90" /><mxPoint x="2364.15" y="936.90" /></Array></mxGeometry></mxCell><mxCell id="v2_ee10" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_e2b" target="v2_e_out"><mxGeometry x="-1" relative="1" as="geometry" /></mxCell><mxCell id="m13" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;Why E2 checks the band numbers&lt;/div&gt;&lt;div&gt;CASTEP's ΔSCF constraints name a band number and spin channel, the same at every k-point. A level that disperses, or crosses a host band somewhere, would move the electron into different states at different k-points. In the electronic cell the band edges fold onto Γ and a localised level is flat, so the check passes; where it fails, E2 runs at Γ, where the bands are unambiguous.&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes"><mxGeometry x="2209.20" y="1947.81" width="500.30" height="168.00" as="geometry" /></mxCell><mxCell id="m14" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;div style=&quot;font-weight:600;font-size:14.91px;margin-bottom:3.3px&quot;&gt;Why PBE from E on&lt;/div&gt;&lt;div&gt;CASTEP's ΔSCF does not support hybrid functionals, so E2 and G stay at PBE (A1's settings). The hybrid is used where it decides the structure (D1–D5); the finalists from G go on to better methods (MBPT, or a hybrid ΔSCF elsewhere).&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;spacingLeft=11.77;rounded=1;absoluteArcSize=1;arcSize=12.56;fillColor=#fafaf8;strokeColor=#c9c7c0;strokeWidth=1.37;spacingRight=9.81;spacingTop=6.83;" vertex="1" parent="notes"><mxGeometry x="2209.20" y="2126.81" width="500.30" height="132.00" as="geometry" /></mxCell><mxCell id="v2_g_in" value="F" style="ellipse;aspect=fixed;fontStyle=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=16.48;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2880.14" y="1236.00" width="47.09" height="47.09" as="geometry" /></mxCell><mxCell id="v2_g1" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;G1  Configuration coordinate&lt;/span&gt;&lt;br&gt;ground-state and ΔSCF single points&lt;br&gt;along the line between the relaxed&lt;br&gt;states; parabolas: ħω and S of each,&lt;br&gt;and the 1D lineshape&lt;/div&gt;" style="shape=process;size=0.0324;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2758.50" y="1310.00" width="290.40" height="129.20" as="geometry" /></mxCell><mxCell id="v2_g_more" value="&lt;div style=&quot;line-height:1.28&quot;&gt;Multi-mode&lt;br&gt;lineshape?&lt;br&gt;(&lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;lineshape&lt;/span&gt;)&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=0;spacingLeft=0.0;spacingRight=0.0;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2785.99" y="1467.20" width="235.40" height="140.00" as="geometry" /></mxCell><mxCell id="v2_g_end1" value="&lt;div style=&quot;line-height:1.28&quot;&gt;End: 1D lineshapes&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;spacing=0;spacingLeft=18.36;spacingRight=18.36;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="3056.70" y="1499.35" width="188.30" height="75.70" as="geometry" /></mxCell><mxCell id="v2_g2a" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;G2  A PBE model per defect&lt;/span&gt;&lt;br&gt;trained on displaced single points&lt;br&gt;(production settings) and E1's steps;&lt;br&gt;one head, the charge embedded&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#e2f3e6;strokeColor=#1f8a3c;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2758.50" y="1635.20" width="290.40" height="111.40" as="geometry" /></mxCell><mxCell id="v2_g2b" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;G2  Phonons in a big cell&lt;/span&gt;&lt;br&gt;finite differences with the model;&lt;br&gt;ΔF (or ΔR) on each mode: the partial&lt;br&gt;Huang–Rhys factors S&lt;sub&gt;k&lt;/sub&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#e2f3e6;strokeColor=#1f8a3c;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2758.50" y="1774.60" width="290.40" height="111.40" as="geometry" /></mxCell><mxCell id="v2_g2c" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;G2  Multi-mode lineshape&lt;/span&gt;&lt;br&gt;S(ħω) and the generating function,&lt;br&gt;at &lt;span style=&quot;font-family:IBM Plex Mono,monospace;font-size:13.09px&quot;&gt;lineshape_temperature&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2758.50" y="1914.00" width="290.40" height="93.60" as="geometry" /></mxCell><mxCell id="v2_g_end2" value="&lt;div style=&quot;line-height:1.28&quot;&gt;End: lineshapes&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;spacing=0;spacingLeft=18.36;spacingRight=18.36;fillColor=#ffffff;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" vertex="1" parent="flow"><mxGeometry x="2758.50" y="2035.60" width="290.40" height="61.20" as="geometry" /></mxCell><mxCell id="v2_eg1" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_g_in" target="v2_g1"><mxGeometry x="-1" relative="1" as="geometry" /></mxCell><mxCell id="v2_eg2" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;" edge="1" parent="flow" source="v2_g1" target="v2_g_more"><mxGeometry x="-1" relative="1" as="geometry" /></mxCell><mxCell id="v2_eg3" value="yes" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonal
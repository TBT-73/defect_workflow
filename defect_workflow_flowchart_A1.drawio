        <mxCell id="n_cq00" parent="notes" style="shape=process;size=0.0253;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;C2  Screen&lt;/span&gt;&lt;br&gt;cheap CASTEP pass, every candidate,&lt;br&gt;charge state and starting spin&lt;/div&gt;" vertex="1">
          <mxGeometry height="66.05" width="372.77" x="2392.6" y="1595.07" as="geometry" />
        </mxCell>
        <mxCell id="n_cq01" parent="notes" style="shape=process;size=0.0253;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;C4–C6  Ground-state search&lt;/span&gt;&lt;br&gt;distortions relaxed in CASTEP,&lt;br&gt;in every charge state&lt;/div&gt;" vertex="1">
          <mxGeometry height="66.05" width="372.77" x="2392.6" y="1682.69" as="geometry" />
        </mxCell>
        <mxCell id="n_cq02" parent="notes" style="shape=process;size=0.0253;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;D0, D1  Production&lt;/span&gt;&lt;br&gt;CASTEP relaxations of the best&lt;br&gt;structures, every charge state&lt;/div&gt;" vertex="1">
          <mxGeometry height="66.05" width="372.77" x="2392.6" y="1770.32" as="geometry" />
        </mxCell>
        <mxCell id="n_cq03" parent="notes" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#f1f0ec;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#1d1d1b;" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;E2  Levels&lt;/span&gt;&lt;br&gt;at the D1 functional&lt;/div&gt;" vertex="1">
          <mxGeometry height="48.22" width="372.77" x="2392.6" y="1857.95" as="geometry" />
        </mxCell>
        <mxCell id="n_cq04" parent="notes" style="rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=6.28;spacingRight=6.28;fillColor=#e2f3e6;strokeColor=#1f8a3c;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#55544f;dashed=1;dashPattern=3.8 2.6;" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;F2–F4  Phonons (not scripted)&lt;/span&gt;&lt;br&gt;one fine-tuned, charge-blind&lt;br&gt;MACE per charge state&lt;/div&gt;" vertex="1">
          <mxGeometry height="66.05" width="372.77" x="2392.6" y="1927.75" as="geometry" />
        </mxCell>
        <mxCell id="n_cq10" parent="notes" style="shape=process;size=0.0253;backgroundOutline=1;rounded=1;absoluteArcSize=1;arcSize=9.42;whiteSpace=wrap;html=1;spacing=0;spacingLeft=1.96;spacingRight=1.96;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=13.93;fontColor=#55544f;dashed=1;dashPattern=3.8 2.6;" value="&lt;div style=&quot;line-height:1.28&quot;&gt;&lt;span style=&quot;font-weight:600;font-size:14.91px&quot;&gt;Training data&lt;/span&gt;&lt;br&gt;a few cheap CASTEP relaxations and&lt;br&gt;distortions per charge state&lt;/div&gt;" vertex="1">
          <mxGeometry height="66.05" width="372.77" x="2820.3" y="1595.07" as="geometry" />

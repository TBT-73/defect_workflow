        <mxCell id="e101" edge="1" parent="notes" source="n_cq13" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=8;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b2b28;strokeWidth=1.65;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A400%2C600%2C700;fontSize=12.95;fontStyle=1;fontColor=#1d1d1b;labelBackgroundColor=none;dashed=1;dashPattern=3.8 2.6;" target="n_cq14" value="">
